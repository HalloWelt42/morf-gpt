# Wird von start.sh beim ersten Start als .env angelegt (nie überschrieben).
# Alle Werte sind Vorgaben; die Oberfläche steuert Anbieter, Quellen und Grenzen.

# Docker-Projektname (eindeutig je Klon, sonst teilen sich Klone Container und Netz)
COMPOSE_PROJECT_NAME=morf-gpt

# Datenbank (Docker, pgvector)
MORF_DB_NAME=morfgpt
MORF_DB_NUTZER=morf
MORF_DB_PASSWORT=morf
MORF_DB_PORT=5462

# Backend und Oberfläche
MORF_BACKEND_HOST=127.0.0.1
MORF_BACKEND_PORT=8460
MORF_FRONTEND_PORT=5460

# Betrieb der gebauten App im Container (Profil "app")
MORF_APP_PORT=8460

# Schlüssel der Hetzner-Inferenz (nur lokal, nie im Repo). Wird beim ersten Start als Anbieter angelegt.
MORF_HETZNER_API_SCHLUESSEL=

# Beim Start des Backends ausstehende Datenbankmigrationen anwenden (Vorgabe: true)
# MORF_MIGRATION_BEIM_START=true
